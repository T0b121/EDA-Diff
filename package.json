{
  "_filePurpose": [
    "Web toolchain manifest for EDA-Diff.",
    "Defines the TypeScript/Vite development commands and browser build dependencies."
  ],
  "name": "eda-diff",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build:web": "tsc --noEmit && vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}
