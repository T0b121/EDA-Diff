/*
TypeScript compiler configuration for the browser application.

Keep browser-facing type checking rules here. Rust/WASM build configuration and
EDA-domain logic belong to the Rust core instead of this file.
*/
{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["src/web/**/*.ts", "vite.config.ts"]
}
